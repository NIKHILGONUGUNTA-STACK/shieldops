# Aegis Simulation Environment Variables (Template)
# Copy this file to .env and configure local values. Never commit .env to version control.

# Target Gateway Configuration
SIMULATION_GATEWAY_BASE_URL=http://localhost:8000
SIMULATION_ALLOW_NON_LOCAL=false

# Keycloak Authentication Configuration
SIMULATION_KEYCLOAK_BASE_URL=http://localhost:8080
SIMULATION_KEYCLOAK_REALM=aegis-dev
SIMULATION_KEYCLOAK_CLIENT_ID=aegis-local

# Downstream Direct Health Probes (Used only by 'doctor' command)
SIMULATION_CUSTOMER_SERVICE_URL=http://localhost:8081
SIMULATION_ACCOUNT_SERVICE_URL=http://localhost:8082
SIMULATION_TRANSACTION_SERVICE_URL=http://localhost:8083

# Client Behavior & Safety Defaults
SIMULATION_HTTP_TIMEOUT_SECONDS=10.0
SIMULATION_MAX_RETRIES=2
SIMULATION_MAX_CONCURRENCY=5
SIMULATION_ENVIRONMENT_ID=local-dev
SIMULATION_ALLOW_SYNTHETIC_SOURCE_IP=false

# Synthetic Customer Identities (Optional local test credentials)
# Keycloak test accounts provisioned in local aegis-dev realm
SIMULATION_USER_ALEX_PASSWORD=placeholder_alex_password
SIMULATION_USER_SAM_PASSWORD=placeholder_sam_password
SIMULATION_USER_ANALYST_PASSWORD=placeholder_analyst_password

