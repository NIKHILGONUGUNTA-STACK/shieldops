# =========================================================================
# AEGIS API SECURITY OPERATIONS PLATFORM — PRODUCTION ENVIRONMENT CONFIG
# =========================================================================
# Usage: Copy this file to .env.production and replace all placeholder secrets
# before deploying the production stack:
#   cp .env.production.example .env.production
#   docker compose -f infrastructure/docker/compose.prod.yml --env-file .env.production up -d
# =========================================================================

COMPOSE_PROJECT_NAME=aegis-prod

# -------------------------------------------------------------------------
# Container Image Tags
# -------------------------------------------------------------------------
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7.4-alpine
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0.5
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
GRAFANA_IMAGE=grafana/grafana:11.2.0

# -------------------------------------------------------------------------
# PostgreSQL Database Secrets
# -------------------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_AEGIS_DB=aegis
POSTGRES_KEYCLOAK_DB=keycloak
POSTGRES_USER=aegis_admin
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_SECURE_POSTGRES_PASSWORD_RANDOM_BASE64_KEY

# -------------------------------------------------------------------------
# Redis Secrets
# -------------------------------------------------------------------------
REDIS_PORT=6379
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_SECURE_REDIS_PASSWORD_RANDOM_BASE64_KEY

# -------------------------------------------------------------------------
# Keycloak IAM Admin Credentials
# -------------------------------------------------------------------------
KEYCLOAK_PORT=8080
KEYCLOAK_MANAGEMENT_PORT=9000
KEYCLOAK_ADMIN=admin
# Generate with: openssl rand -base64 24
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_SECURE_KEYCLOAK_ADMIN_PASSWORD

# -------------------------------------------------------------------------
# Aegis Internal Trust Token (Zero-Trust Service-to-Service Secret)
# -------------------------------------------------------------------------
# MUST be at least 32 characters long
# Generate with: openssl rand -hex 32
AEGIS_INTERNAL_SECRET=CHANGE_ME_MUST_BE_AT_LEAST_32_CHARACTERS_INTERNAL_SECRET_KEY!

# -------------------------------------------------------------------------
# Gateway & Frontend Ingress Ports
# -------------------------------------------------------------------------
GATEWAY_PORT=8000
FRONTEND_PORT=80

# -------------------------------------------------------------------------
# Monitoring & Metrics (Prometheus & Grafana)
# -------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Generate with: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_SECURE_GRAFANA_ADMIN_PASSWORD
