# Copy this file to config/dev.env before starting the local stack.
# Values below are development-only examples. Replace all *_PASSWORD values.

COMPOSE_PROJECT_NAME=aegis
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_PORT=5432
POSTGRES_AEGIS_DB=aegis
POSTGRES_KEYCLOAK_DB=keycloak
POSTGRES_USER=aegis_owner
POSTGRES_PASSWORD=change-this-local-postgres-password

REDIS_IMAGE=redis:7-alpine
REDIS_PORT=6379

KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.4.2
KEYCLOAK_PORT=8080
KEYCLOAK_MANAGEMENT_PORT=9000
KEYCLOAK_ADMIN=aegis_admin
KEYCLOAK_ADMIN_PASSWORD=change-this-local-keycloak-password

# Synthetic FinTech service host ports
CUSTOMER_SERVICE_PORT=8081
ACCOUNT_SERVICE_PORT=8082
TRANSACTION_SERVICE_PORT=8083
